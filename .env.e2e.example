# Copy to .env.e2e.local (gitignored) and fill in your TEST Supabase project's
# values — see the "End-to-end tests" section in README.md. Never point this at
# your real project: the test suite creates and modifies real bands/tours/shows.
VITE_SUPABASE_URL=https://your-test-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-test-project-anon-key
